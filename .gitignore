# ── Python ────────────────────────────────────────────────────────────────
# Local virtual environments (project venv is ~1 GB)
venv/
.venv/
env/
ENV/

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output (regenerated by `npm run build`)
frontend/dist/
dist/
.vite/

# ── Environment / secrets ─────────────────────────────────────────────────
# Never commit real API keys or deployment URLs.
.env
.env.*
!.env.example
!.env.*.example

# ── Generated outputs ─────────────────────────────────────────────────────
outputs/
outputs/screenshots/
outputs/graphs/
screenshots/

# Ad-hoc / intermediate visual verification renders
# Note: data/processed/level7*/visual_verification/ does NOT match
# data/processed/level7/level7c_visual_verification/, so these are listed
# explicitly.
data/processed/fragment_visual_verification/
data/processed/level7/duplicate_visual_verification/
data/processed/level7/level7c_visual_verification/
data/processed/level7/level7d_visual_verification/
data/processed/level7*/visual_verification/

# ── Large video assets (not deployed from Git) ─────────────────────────────
# These MP4s total ~377 MB. They are recorded demo/source footage, not source
# code, and the deployed build does not need them in the repository:
#   data/demo_cctv/         the 9 recorded demo CCTV clips (~267 MB) — served
#                            from an external bucket (Cloudflare R2) in
#                            production via VITE_DEMO_CCTV_BASE_URL, and
#                            streamed by the Vite dev/preview server locally
#   data/raw_videos/        source clips for the batch pipeline (~34 MB);
#                            byte-for-byte duplicates of
#                            frontend/public/recordings/
#   frontend/public/recordings/  copies bundled into the static build (~34 MB)
#
# The files stay on disk, so local `npm run dev`, `vite preview` and the real ML
# E2E test are unaffected. Only Git tracking is removed. See
# docs/deployment-notes.md.
data/demo_cctv/
data/raw_videos/
frontend/public/recordings/

# ── Runtime / temporary uploads ────────────────────────────────────────────
# The API writes uploads to the OS temp dir and deletes them afterwards; this
# catches any that survive a hard kill so they are never committed.
upload_*.mp4
upload_*.avi
upload_*.mov
upload_*.mkv
tmp/
temp/

# ── OS / editor noise ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Deliberately NOT ignored (required for deployment) ────────────────────
# yolov8n.pt                 the YOLO weights used at runtime (6.25 MB) — the
#                            deployed API loads this from the repo root
# api/                        the FastAPI backend
# src/                        the existing ML pipeline + bytetrack_traffic.yaml
# frontend/src/               the React application
# frontend/scripts/           data preparation and the test suite
# frontend/public/            level8 images and icons (the .mp4 clips under
#                            frontend/public/recordings/ ARE ignored, see above)
# config/, data/processed/    prepared JSON evidence consumed by the frontend
# requirements.txt, requirements-api.txt, render.yaml, runtime.txt
# frontend/.env.production.example
#
# Note: .env and .env.* are ignored above, so the real local environment files
# (frontend/.env.development, frontend/.env.production, which hold only local
# backend URLs) stay out of Git. Only the example files are explicitly
# re-included (!.env.example, !.env.*.example) because they contain placeholders
# only — never a real URL, key or token.
