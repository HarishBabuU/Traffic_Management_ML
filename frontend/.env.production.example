# Frontend production environment TEMPLATE — document these in the Cloudflare
# Pages dashboard before building, or copy to `.env.production.local`.
#
# Do NOT commit real URLs here. This is an example only.
#
# Vite inlines VITE_* variables at BUILD time, so the deployed frontend must be
# rebuilt whenever either value changes. The local development configuration in
# `.env.development` (http://127.0.0.1:8110) keeps working untouched, and both
# variables below are OPTIONAL there.
#
# The deployed static site is served over HTTPS, so the backend URL must also be
# HTTPS — a browser blocks mixed content, and CORS must allow the Pages origin.

# ── 1. FastAPI ML backend ─────────────────────────────────────────────────
# Base URL of the deployed backend. No trailing slash.
# The frontend appends /api/analyze-video, /health and /api/info to it.
VITE_API_BASE_URL=https://REPLACE-WITH-YOUR-BACKEND-URL

# ── 2. Recorded demo CCTV clips (Cloudflare R2) ───────────────────────────
# Public base URL of the bucket that will host the recorded demo clips.
# Leave UNSET to keep the current local behaviour:
#   public/recordings/*.mp4  -> `recordings/<file>`
#   data/demo_cctv/*         -> `/demo-cctv/<route>/<file>`  (Vite dev/preview
#                               server only; a static build has no Vite server,
#                               so these clips will not play without this value)
#
# When set, both paths are prefixed with it. No R2 endpoint is hardcoded in the
# source; the route folder and the encoded filename are preserved either way.
#
# Expected key layout inside the bucket:
#   recordings/low traffic.mp4
#   recordings/no traffic video.mp4
#   recordings/traffic.mp4
#   demo-cctv/route_a/CCTV-A01.mp4 … CCTV-A03.mp4
#   demo-cctv/route_b/CCTV-B01.mp4 … CCTV-B03.mp4
#   demo-cctv/route_c/CCTV-C01.mp4 … CCTV-C03.mp4
#
# The clips are RECORDED DEMO footage: not live, and not geographically mapped.
VITE_DEMO_CCTV_BASE_URL=https://REPLACE-WITH-YOUR-PUBLIC-DEMO-VIDEO-BASE

# ── Matching backend configuration ────────────────────────────────────────
# 1. Set the Pages origin as FRONTEND_ORIGIN on the Render web service, e.g.
#      FRONTEND_ORIGIN=https://REPLACE-WITH-YOUR-PAGES-URL
# 2. Render injects $PORT at runtime; the start command must not hardcode one:
#      uvicorn api.main:app --host 0.0.0.0 --port $PORT
# 3. The backend accepts one analysis at a time and returns HTTP 429 if a second
#    request arrives while one is running. MAX_UPLOAD_MB defaults to 50.